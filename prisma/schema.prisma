datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  MEMBER
}

model Unit {
  id    String @id @default(cuid())
  name  String @unique
  isActive Boolean @default(true)
  
  users                 User[]
  supervisors           User[] @relation("SupervisedUnits")
  categories            Category[]
  equipments            Equipment[]
  borrowRequests        BorrowRequest[]
  notifications         Notification[]
  settings              Setting[]
  maintenances          Maintenance[]
  areas                 Area[]
  rooms                 Room[]
  classroomEqCategories ClassroomEqCategory[]
  deviceConfigs         DeviceConfig[]
  classroomEquipments   ClassroomEquipment[]
  inventorySessions     InventorySession[]
  inventoryRecords      InventoryRecord[]
  systemLogs            SystemLog[]
  positions             Position[]
  departments           Department[]
}

model Department {
  id    String @id @default(cuid())
  name  String
  
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  users User[]

  @@unique([name, unitId])
}

model Position {
  id    String @id @default(cuid())
  name  String
  
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  users User[]

  @@unique([name, unitId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?
  image         String?
  password      String?
  role          Role      @default(MEMBER)
  isActive      Boolean   @default(true)
  
  unitId        String?
  unit          Unit?       @relation(fields: [unitId], references: [id])
  supervisedUnits Unit[]    @relation("SupervisedUnits")
  positionId    String?
  position      Position?   @relation(fields: [positionId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  requests      BorrowRequest[]
  notifications Notification[]
  managedRooms  Room[]
  managedCategories Category[]
  inventorySessions InventorySession[]
  inventoryRecords InventoryRecord[]
  systemLogs    SystemLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  managerId   String?
  manager     User?    @relation(fields: [managerId], references: [id])
  equipments  Equipment[]

  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])

  @@unique([name, unitId])
  @@index([managerId])
  @@index([unitId])
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  barcode     String?  @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  image       String?
  totalQty    Int      @default(0)
  availableQty Int     @default(0)
  createdAt   DateTime @default(now())
  creatorName String?
  
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  
  requests    BorrowRequest[]
  maintenances Maintenance[]
  inventoryRecords InventoryRecord[] @relation("InventoryEquip")

  @@index([categoryId])
  @@index([name])
  @@index([unitId])
}

model BorrowRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int      @default(1)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  borrowDate  DateTime
  returnDate  DateTime
  actualReturnDate DateTime?
  rejectionReason  String?
  reviewerName     String?
  approvedAt       DateTime?
  returnReviewerName String?
  returnCondition  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([equipmentId])
  @@index([createdAt])
  @@index([unitId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])

  @@index([userId, isRead])
  @@index([unitId])
}

model Setting {
  id    String @id @default(cuid())
  key   String
  value String

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  @@unique([key, unitId])
  @@index([unitId])
}

model Maintenance {
  id          String   @id @default(cuid())
  
  equipmentId   String?
  equipment     Equipment? @relation(fields: [equipmentId], references: [id])
  
  classroomEqId String?
  classroomEq   ClassroomEquipment? @relation(fields: [classroomEqId], references: [id])
  
  quantity    Int      @default(1)
  description String
  cost        Float?
  status      String   @default("COMPLETED") // PENDING, IN_PROGRESS, COMPLETED, BROKEN
  date        DateTime @default(now())
  handlerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  
  @@index([unitId])
}

model Area {
  id   String @id @default(cuid())
  name String
  rooms Room[]
  classroomEquipments ClassroomEquipment[]

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  @@unique([name, unitId])
  @@index([unitId])
}

model Room {
  id     String @id @default(cuid())
  name   String
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])
  managerId String?
  manager   User?  @relation(fields: [managerId], references: [id])
  classroomEquipments ClassroomEquipment[]

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  @@unique([areaId, name])
  @@index([unitId])
}

model ClassroomEqCategory {
  id   String @id @default(cuid())
  name String
  equipments ClassroomEquipment[]

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  @@unique([name, unitId])
  @@index([unitId])
}

model DeviceConfig {
  id   String @id @default(cuid())
  name String
  equipments ClassroomEquipment[]

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
  
  @@unique([name, unitId])
  @@index([unitId])
}

model ClassroomEquipment {
  id         String @id @default(cuid())
  name       String
  image      String?
  
  areaId     String
  area       Area   @relation(fields: [areaId], references: [id])
  
  roomId     String
  room       Room   @relation(fields: [roomId], references: [id])
  
  categoryId String
  category   ClassroomEqCategory @relation(fields: [categoryId], references: [id])
  
  configs    DeviceConfig[]
  
  quantity   Int @default(1)
  
  creatorName   String?
  updatedByName String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  
  maintenances Maintenance[]
  inventoryRecords InventoryRecord[] @relation("InventoryClassroomEquip")

  unitId     String?
  unit       Unit?   @relation(fields: [unitId], references: [id])

  @@index([areaId])
  @@index([roomId])
  @@index([categoryId])
  @@index([unitId])
}

model InventorySession {
  id          String   @id @default(cuid())
  name        String   // VD: "Kiểm kê tháng 5/2026"
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  records     InventoryRecord[]
  createdAt   DateTime @default(now())

  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  
  @@index([unitId])
}

model InventoryRecord {
  id            String   @id @default(cuid())
  
  sessionId     String?
  session       InventorySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  equipmentId   String?  
  equipment     Equipment? @relation("InventoryEquip", fields: [equipmentId], references: [id])
  
  classroomEqId String?
  classroomEq   ClassroomEquipment? @relation("InventoryClassroomEquip", fields: [classroomEqId], references: [id])

  scannerId     String
  scanner       User     @relation(fields: [scannerId], references: [id])

  location      String?  // Vị trí thực tế
  note          String?  // Ghi chú tình trạng
  status        String   @default("PRESENT") // PRESENT, MISSING, DAMAGED
  quantity      Int      @default(1)

  createdAt     DateTime @default(now())

  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])

  @@index([sessionId])
  @@index([equipmentId])
  @@index([classroomEqId])
  @@index([scannerId])
  @@index([unitId])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE, REJECT, etc.
  entity    String   // equipment, request, member, category, borrow, inventory, etc.
  entityId  String?
  detail    String   @db.Text
  createdAt DateTime @default(now())

  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([unitId])
}
